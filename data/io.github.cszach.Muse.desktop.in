[Desktop Entry]
Type=Application
Version=1.5
Name=Muse
GenericName=AI Assistant
Comment=Unofficial desktop client for Meta's Muse
Exec=@BINDIR@/muse %U
Icon=io.github.cszach.Muse
Terminal=false
Categories=Network;Chat;GTK;GNOME;
Keywords=AI;assistant;agent;chat;Meta;Muse;
StartupNotify=true
DBusActivatable=true
X-GNOME-UsesNotifications=true
SingleMainWindow=false
Actions=quick-ask;new-window;

[Desktop Action quick-ask]
Name=Quick Ask
Exec=@BINDIR@/muse --quick-ask

[Desktop Action new-window]
Name=New Window
Exec=@BINDIR@/muse --new-window

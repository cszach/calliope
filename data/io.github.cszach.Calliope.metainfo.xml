<component type="desktop-application">
  <id>io.github.cszach.Calliope</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Calliope</name>
  <summary>Unofficial desktop client for Muse</summary>
  <developer id="io.github.cszach">
    <name>Zach</name>
  </developer>

  <description>
    <p>
      Calliope brings Muse, Meta’s AI agent, to the GNOME desktop. It runs the
      real Muse website in GNOME’s own web engine, so every Muse feature is
      there, and adds what a browser tab cannot:
    </p>
    <ul>
      <li>Quick Ask: a small window for questions, opened from any app with a keyboard shortcut</li>
      <li>Ask Muse from the Activities overview search</li>
      <li>Notifications from Muse, even with the window closed, when running in the background</li>
      <li>Tabs and windows that share one login, kept across restarts</li>
      <li>Downloads, file uploads and voice mode</li>
    </ul>
    <p>
      Calliope is not affiliated with or endorsed by Meta. Muse is a trademark
      of Meta Platforms, Inc. You need a Muse account to use it.
    </p>
  </description>

  <launchable type="desktop-id">io.github.cszach.Calliope.desktop</launchable>
  <provides>
    <binary>calliope</binary>
    <dbus type="user">io.github.cszach.Calliope</dbus>
  </provides>

  <url type="homepage">https://github.com/cszach/calliope</url>
  <url type="bugtracker">https://github.com/cszach/calliope/issues</url>
  <url type="vcs-browser">https://github.com/cszach/calliope</url>

  <branding>
    <color type="primary" scheme_preference="light">#dc8add</color>
    <color type="primary" scheme_preference="dark">#613583</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Muse in its own window</caption>
      <image>https://raw.githubusercontent.com/cszach/calliope/main/data/screenshots/main.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/cszach/calliope/main/data/screenshots/preferences.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>

  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <keywords>
    <keyword>AI</keyword>
    <keyword>Assistant</keyword>
    <keyword>Agent</keyword>
    <keyword>Chat</keyword>
    <keyword>Muse</keyword>
  </keywords>

  <releases>
    <release version="0.1.0" date="2026-10-08">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
